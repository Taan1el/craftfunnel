{
  "name": "craftfunnel",
  "version": "1.0.0",
  "description": "Conversion funnel simulation and user behavior analytics: acquisition funnel tracking, deterministic A/B testing, and Stripe webhook reconciliation",
  "private": true,
  "type": "module",
  "license": "MIT",
  "homepage": "https://taan1el.github.io/craftfunnel/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Taan1el/craftfunnel.git"
  },
  "bugs": {
    "url": "https://github.com/Taan1el/craftfunnel/issues"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "dev": "npm run dev:server",
    "build:server": "npm run build --workspace=server",
    "build:client": "npm run build --workspace=client",
    "build": "npm run build:server && npm run build:client",
    "build:pages": "npm run build:pages --workspace=client",
    "test:server": "npm run test --workspace=server",
    "test:client": "npm run test --workspace=client",
    "test": "npm run test:server && npm run test:client",
    "lint:server": "npm run lint --workspace=server",
    "lint:client": "npm run lint --workspace=client",
    "lint": "npm run lint:server && npm run lint:client"
  },
  "devDependencies": {
    "typescript": "^5.8.2"
  }
}
